# ---------------------------------------------------------------------
# STARK ANCHORS — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------

# Diagnostic intake destination.
#
# Any endpoint that accepts a JSON POST: a CRM intake URL, a Zapier or
# Make webhook, a Slack workflow, a mail relay, your own API.
#
# While this is unset, /api/diagnostic answers 501 and the diagnostic
# portal tells the visitor plainly that intake is not connected and
# offers a direct mailto fallback containing their answers. It does NOT
# show a confirmation screen for a submission that went nowhere.
DIAGNOSTIC_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` with the forwarded
# submission. Leave blank if the destination does not require auth.
DIAGNOSTIC_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------
# Payload shape delivered to DIAGNOSTIC_WEBHOOK_URL:
#
# {
#   "source": "starkanchors.com",
#   "form": "system-diagnostic",
#   "receivedAt": "2026-08-26T16:05:18.834Z",   // stamped server-side
#   "submission": {
#     "fullName": "...", "company": "...", "email": "...",
#     "website": "...", "stack": "...", "scale": "...",
#     "leakageArea": "...", "leakageContext": "...",
#     "automationGoal": "...", "successDefinition": "...",
#     "timeline": "...", "additionalContext": "..."
#   }
# }
#
# Fields are declared in data/diagnostic.ts. Adding one there adds it to
# the interface, the validation and this payload with no other changes.
# ---------------------------------------------------------------------
